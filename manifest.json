{
    "manifest_version": 3,
    "name": "Simulador de Actividad",
    "version": "1.0",
    "description": "Simula actividad para evitar bloqueo de pantalla",
    "permissions": [
        "scripting",
        "storage",
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "icons": {
        "16": "icons/tiempo-de-inactividad-16.png",
        "48": "icons/tiempo-de-inactividad-64.png",
        "128": "icons/tiempo-de-inactividad-128.png"
    }
}